# cp .env.example .env ; do NOT commit .env. Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
BRIDGE_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_SECRET
BLACKBOX_FTP_HOST=portal.blackbox.global
BLACKBOX_FTP_PORT=21
BLACKBOX_FTP_USER=YOUR_BLACKBOX_FTP_USERNAME
BLACKBOX_FTP_PASSWORD=YOUR_BLACKBOX_FTP_PASSWORD
# Verify the server's current FTP directory using a real FTP client/account; may differ.
BLACKBOX_FTP_DIR=stock_footage
# file:// has Origin: null. Also whitelist the dashboard's hosted HTTPS origin if using one.
CORS_ORIGINS=null,https://YOUR-DASHBOARD-DOMAIN.example
AI_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=YOUR_SERVER_SIDE_VISION_API_KEY
AI_MODEL=gpt-4o-mini
MAX_UPLOAD_BYTES=8589934592
